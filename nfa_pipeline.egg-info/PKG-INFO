│   │
│   ├── validators/
│   │   └── record_validator.py     # Field-level + batch validation
│   │
│   ├── storage/
│   │   ├── sqlite_storage.py       # SQLite with WAL mode + UPSERT
│   │   ├── excel_exporter.py       # Formatted Excel workbook (openpyxl)
│   │   └── csv_exporter.py         # UTF-8 CSV with BOM
│   │
│   └── utils/
│       ├── http_client.py          # Session + retries + cache + robots.txt
│       ├── checkpoint.py           # Resumable run state
│       └── logging_setup.py        # Rotating file + colour console logs
│
├── config/
│   └── settings.yaml               # All pipeline configuration
│
├── tests/                          # pytest test suite
│   ├── test_models.py
│   ├── test_extractor.py
│   ├── test_transformer.py
│   ├── test_validator.py
│   ├── test_storage.py
│   └── test_checkpoint_config.py
│
├── scripts/
│   └── run_pipeline.py             # Convenience runner
│
├── data/                           # Auto-created by pipeline
│   ├── raw/                        # (reserved for raw HTML dumps)
│   ├── processed/                  # nfa_awards.xlsx, nfa_awards.csv, nfa_awards.db
│   ├── logs/                       # pipeline.log (rotating, 10 MB × 5)
